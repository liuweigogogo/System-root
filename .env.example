# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_USER=flask_user
DB_PASSWORD=your_password_here
DB_NAME=file_converter

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Flask 配置
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=your_secret_key_here

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=5000
DEBUG=False

# 文件上传配置
UPLOAD_FOLDER=/app/uploads
MAX_CONTENT_LENGTH=16777216

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
